# Copy to .env for local use (never commit .env). On your host, set these as environment variables.
PRONOTE_URL=https://XXXXXXX.index-education.net/pronote/eleve.html
PRONOTE_USERNAME=
PRONOTE_PASSWORD=
# Only if you log in through your school's ENT, e.g. ac_lyon (see pronotepy.ent)
PRONOTE_ENT=
# Password protecting your site (username can be anything)
APP_PASSWORD=change-me
CACHE_SECONDS=300
